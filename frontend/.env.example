# Local dev (`npm run dev`): leave unset — requests go to /api via Vite proxy.
# PARKSMART_DEV_API_URL=http://127.0.0.1:8000

# Override API for local `vite preview` or custom builds only (optional).
# If unset when you `vite build`, the app defaults to Fly in production bundles.
# VITE_API_URL=https://parksmart-api.fly.dev
